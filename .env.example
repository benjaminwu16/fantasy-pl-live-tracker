# Existing FPL / Google settings
FPL_LEAGUE_ID=2147846
GOOGLE_SHEET_ID=your_existing_sheet_id
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# OpenAI announcement generation
USE_OPENAI_LLM=true
OPENAI_API_KEY=sk-your-secret-key-here

# Model
OPENAI_MODEL=gpt-5.6-sol
OPENAI_TEMPERATURE=0.85
OPENAI_REASONING_EFFORT=none

# Start without web search to minimize spend.
OPENAI_WEB_SEARCH=false

# Useful while testing: prints token usage to stderr.
OPENAI_SHOW_USAGE=true